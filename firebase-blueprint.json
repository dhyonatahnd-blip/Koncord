        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "recipientId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 48 },
        "type": { "type": "string", "enum": ["message", "dm", "invite", "friend_request", "voice_join", "screen_share"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "body": { "type": "string", "maxLength": 240 },
        "linkServerId": { "type": "string", "maxLength": 128 },
        "linkChannelId": { "type": "string", "maxLength": 128 },
        "linkUserId": { "type": "string", "maxLength": 128 },
        "inviteCode": { "type": "string", "maxLength": 24 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "recipientId", "senderId", "senderName", "type", "title", "body", "linkServerId", "linkChannelId", "linkUserId", "inviteCode", "read", "createdAt"]
    },
    "ZoneSignal": {
      "title": "ZoneSignal",
      "description": "Peer-to-peer WebRTC SDP and ICE candidate signaling packet.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fromUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fromName": { "type": "string", "maxLength": 48 },
        "toUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "channelId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["rtc:offer", "rtc:answer", "rtc:ice-candidate"] },
        "sdpType": { "type": "string", "maxLength": 32 },
        "sdp": { "type": "string", "maxLength": 32000 },
        "camStreamId": { "type": "string", "maxLength": 128 },
        "screenStreamId": { "type": "string", "maxLength": 128 },
        "candidate": { "type": "string", "maxLength": 4096 },
        "sdpMid": { "type": "string", "maxLength": 64 },
        "sdpMLineIndex": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fromUid", "fromName", "toUid", "channelId", "type", "sdpType", "sdp", "camStreamId", "screenStreamId", "candidate", "sdpMid", "sdpMLineIndex", "createdAt"]
    },
    "ZoneTyping": {
      "title": "ZoneTyping",
      "description": "Transient typing indicator for a Zone text channel or DM.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 260, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "channelKey": { "type": "string", "minLength": 1, "maxLength": 160 },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 48 },
        "isTyping": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "channelKey", "uid", "displayName", "isTyping", "updatedAt"]
    }
  },
