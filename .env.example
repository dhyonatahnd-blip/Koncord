# Optional external WebSocket signaling server URL when hosting frontend statically on Netlify
# Example: VITE_WS_URL="wss://vesper-signaling.onrender.com/ws"
VITE_WS_URL=""

# Set to "true" to force local browser-only fallback without attempting /ws
VITE_STATIC_MODE="false"

# Optional Firebase client overrides (defaults come from firebase-applet-config.json)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""
