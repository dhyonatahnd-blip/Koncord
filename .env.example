# Optional External Backend URL (when frontend is deployed on Netlify)
VITE_API_URL=""
VITE_WS_URL=""
VITE_STATIC_MODE="false"

# Optional Supabase (EU Region Recommended for GDPR)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional LiveKit SFU (Server-side only — never expose LIVEKIT_API_SECRET to frontend)
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Runtime URL injected in production / Cloud Run
APP_URL="MY_APP_URL"
